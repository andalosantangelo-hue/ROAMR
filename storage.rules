rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function img() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }
    function isUser(uid) { return request.auth != null && request.auth.uid == uid; }

    // Files are scoped to the uploader's uid so one user can't overwrite another's
    // images or dump arbitrary objects under a shared prefix.
    // `get` only (no `list`): a public `read` also let anyone list every user's uploads.
    // `delete` is separate from create/update because img() inspects request.resource,
    // which is null on delete — that left owners unable to delete their own files.
    match /tribes/{uid}/{f=**}     { allow get: if true; allow create, update: if isUser(uid) && img(); allow delete: if isUser(uid); }
    match /avatars/{uid}/{f=**}    { allow get: if true; allow create, update: if isUser(uid) && img(); allow delete: if isUser(uid); }
    match /posts/{uid}/{f=**}      { allow get: if true; allow create, update: if isUser(uid) && img(); allow delete: if isUser(uid); }
    match /activities/{uid}/{f=**} { allow get: if true; allow create, update: if isUser(uid) && img(); allow delete: if isUser(uid); }
    match /listings/{uid}/{f=**}   { allow get: if true; allow create, update: if isUser(uid) && img(); allow delete: if isUser(uid); }
    // Verification selfies are PRIVATE — only the owner (and Admin via console) can read.
    match /verifications/{uid}/{f=**} { allow get: if isUser(uid); allow create, update: if isUser(uid) && img(); allow delete: if isUser(uid); }
  }
}
